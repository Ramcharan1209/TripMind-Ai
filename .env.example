# ============ TripMind LLM settings (any OpenAI-compatible API) ============
# FREE option: Google Gemini.  Get a free key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-flash-latest

# true = ask the model for strict JSON (recommended). If your provider rejects it, set false.
LLM_JSON_MODE=true

# set to false if a proxy / VPN / college network makes requests hang (CHECK_LLM.bat tells you)
LLM_TRUST_ENV=true
# seconds to wait for each answer (one retry is made)
LLM_TIMEOUT=45

# less thinking = faster. Use low (or minimal). Leave empty if your provider does not support it.
LLM_REASONING_EFFORT=low

# ---------- Alternative: OpenRouter (comment the Gemini lines above, uncomment these) ----------
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_API_KEY=your-openrouter-key
#LLM_MODEL=pick-a-model-id-from-openrouter.ai/models
#LLM_SITE_URL=http://localhost:8000
#LLM_APP_NAME=TripMind AI

# ---------- Alternative: local Ollama (no key needed) ----------
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_API_KEY=
#LLM_MODEL=llama3.2:3b
